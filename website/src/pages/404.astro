---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Lontar" description="This page doesn't exist.">
  <div class="wrap nf">
    <h1>This page doesn’t exist.</h1>
    <p class="lede">The link may be old or mistyped.</p>
    <p class="actions">
      <a class="button button-primary" href="/">Go to the home page</a>
      <a class="button" href="/download">Download Lontar</a>
    </p>
  </div>
</Base>

<style>
  .nf {
    padding-top: clamp(3rem, 10vw, 7rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
