<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX is not built in M7; identity mirrors build/config.yml. The
     PublisherName must match the subject of the signing certificate. -->
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lontar.exe"
        Arguments=""
        InstallLocation="C:\Program Files\lontar">
    </Installer>
    <PackageInformation
        PackageName="lontar"
        PackageDisplayName="Lontar"
        PublisherName="CN=Lontar contributors"
        PublisherDisplayName="Lontar contributors"
        Version="0.0.0.0"
        PackageDescription="Fast, lightweight database client for PostgreSQL, MySQL/MariaDB and SQLite">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="lontar"
                Description="Fast, lightweight database client for PostgreSQL, MySQL/MariaDB and SQLite"
                DisplayName="Lontar"
                ExecutableName="lontar.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Lontar</DisplayName>
            <PublisherDisplayName>Lontar contributors</PublisherDisplayName>
            <Description>Fast, lightweight database client for PostgreSQL, MySQL/MariaDB and SQLite</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lontar.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
